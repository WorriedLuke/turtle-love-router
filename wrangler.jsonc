
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "turtle-remote-shell",
  "main": "src/index.js",
  "compatibility_date": "2026-11-19",

  "durable_objects": {
    "bindings": [
      {
        "name": "TURTLE_ROUTER",
        "class_name": "TurtleRouter"
      }
    ]
  },

  "exports": {
    "TurtleRouter": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
